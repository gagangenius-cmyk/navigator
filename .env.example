# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://dmconsultant_dm_next:Demo2026DMNEXT@187.127.123.60:3306/crm_next
NODE_ENV=development
PORT=3000

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Meta / Facebook Lead Ads Integration ─────────────────────────────────────
# From Meta for Developers → Your App → Settings → Basic
META_APP_ID=
META_APP_SECRET=

# Random string you choose; must match what you enter in Meta Webhooks config
META_WEBHOOK_VERIFY_TOKEN=

# Long-lived Page Access Token for the Facebook Page receiving leads
# Generate via Facebook Graph API Explorer or Business Manager
META_PAGE_ACCESS_TOKEN=

# Facebook Page ID that your app is subscribed to
META_PAGE_ID=

# Ad Account ID (without the act_ prefix)
META_AD_ACCOUNT_ID=

# Meta Graph API version (default: v21.0)
META_GRAPH_API_VERSION=v21.0

# CRM endpoint where leads are delivered
META_LEADS_CRM_ENDPOINT=https://cmgone.org/api/web-to-leads

# Integration on/off switch (true/false)
META_INTEGRATION_ENABLED=true

# ── Cron Protection ───────────────────────────────────────────────────────────
# Set this and pass it as "Authorization: Bearer <CRON_SECRET>" when calling cron routes
CRON_SECRET=change-me-to-a-random-cron-secret

# ── Vercel Blob (file uploads: proof of payment, signed agreements, documents) ──
# Vercel Dashboard → your project → Storage → Create Database → Blob → connect to
# this project. Then `vercel env pull .env` to copy the token down locally, or
# paste it here manually. Required for /api/upload, /api/opportunity-documents,
# and /api/admin/operations/upload to work — all writes go through @vercel/blob.
BLOB_READ_WRITE_TOKEN=

# ── Realtime Client Chat (Pusher Channels) ───────────────────────────────────
# Powers instant push for the client<->case-officer chat (Operations wizards'
# "Chat"/"Live Chat" tab, and the client portal's Conversation page). Optional:
# if left unset, chat still works fully (messages persist to
# dm_client_conversations and both sides poll every 6s) — these just upgrade
# it from polling to instant WebSocket delivery.
# Create a free app at https://dashboard.pusher.com (Channels product).
# PUSHER_KEY/PUSHER_CLUSTER must exactly match NEXT_PUBLIC_PUSHER_KEY/
# NEXT_PUBLIC_PUSHER_CLUSTER below — the server and browser must agree on the
# same app. The NEXT_PUBLIC_ vars are inlined into the browser bundle at build
# time (Next.js requirement for any client-side env var), so redeploy after
# changing them.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ── Legacy Agreement Archive ─────────────────────────────────────────────────
# Base folder of the pre-dm-next PHP app's contract file store (en_contract/,
# en_annexure_a/, en_annexure_b/ subfolders), read by /api/legacy-agreement-templates.
# Only needed on the machine that still hosts that legacy archive.
LEGACY_AGREEMENT_ROOT=D:\xampp\htdocs\dm
