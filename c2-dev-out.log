        'in_person' AS meetingType,
        STR_TO_DATE(CONCAT(a.date, ' ', TIME_FORMAT(a.appointtime, '%H:%i:%s')), '%Y-%m-%d %H:%i:%s') AS scheduledAt,
        30 AS duration,
        'high' AS priority,
        COALESCE(b.name, 'Office') AS location,
