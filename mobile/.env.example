# Copy to .env (git-ignored) for local `expo start`. EXPO_PUBLIC_* values are
# inlined into the JS bundle at build time - never put secrets here.

# Base URL of the Navigator CRM backend (no trailing slash).
# To test against a backend on your own PC instead, use its LAN IP (not localhost),
# e.g. http://192.168.0.10:3000 - the phone must be on the same Wi-Fi.
EXPO_PUBLIC_API_URL=https://navigatorcrm-one.vercel.app

# development | preview | production - controls the APNs environment the app
# reports on registration and how verbose logging is.
EXPO_PUBLIC_APP_ENV=development

# Optional TLS certificate pinning (SPKI SHA-256, base64), comma separated.
# Leave empty to disable. See src/services/security/sslPinning.ts.
EXPO_PUBLIC_SSL_PINS=

# Build-time only (app.config.ts): path to Firebase google-services.json.
# GOOGLE_SERVICES_FILE=./google-services.json
# EAS_PROJECT_ID=
